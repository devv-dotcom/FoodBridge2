# Email delivery for Food Rescue sign-in and password recovery codes.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM="Food Rescue <no-reply@example.com>"

# One-time sign-in codes expire after 10 minutes by default.
LOGIN_OTP_TTL_MS=600000
